auth = "plain[@SRCDIR@/data/test-group.passwd]"
isolate-workers = @ISOLATE_WORKERS@
max-ban-score = 0
max-clients = 16
tcp-port = @PORT@
udp-port = @PORT@
server-cert = @SRCDIR@/certs/server-cert.pem
server-key = @SRCDIR@/certs/server-key.pem
socket-file = ./ocserv-socket
use-occtl = false
run-as-user = @USERNAME@
run-as-group = @GROUP@
device = vpns
ipv4-network = @VPNNET@

select-group = group1[Label One]
select-group = group2

[vhost:inherits.example.com]
server-cert = @SRCDIR@/certs/server-cert.pem
server-key = @SRCDIR@/certs/server-key.pem
ipv4-network = @VPNNET@

[vhost:replaces.example.com]
server-cert = @SRCDIR@/certs/server-cert.pem
server-key = @SRCDIR@/certs/server-key.pem
ipv4-network = @VPNNET@
select-group = group3[Label Three]
