SERV="${SERV:-../src/ocserv}"
srcdir=${srcdir:-.}
NO_NEED_ROOT=1
PIDFILE=ocserv-pid.$$.tmp

. `dirname $0`/common.sh
. `dirname $0`/random-vpnnet.sh

require_oc_client

eval "${GETPORT}"

echo "Testing local backend with username-password... "

update_config test1.config
echo "udp-port = 0" >>${CONFIG}
echo "cisco-svc-client-compat = true" >>${CONFIG}
launch_simple_sr_server -d 1 -p ${PIDFILE} -f -c ${CONFIG}
PID=$!
wait_server $PID

echo "Connecting to obtain non-auth cookies... "
oc_run svc --method GET || oc_fail "GET request failed"

oc_expect 'Set-Cookie: webvpn=; expires=' "Did not receive cookie"
oc_expect 'Set-Cookie: webvpnlogin=1' "Did not receive non-auth cookie"

echo "Connecting to obtain cookie... "
oc_run svc --user test --password test || oc_fail "POST request failed"

oc_expect 'Set-Cookie: webvpn=[^;]+' "Did not receive cookie"

echo "Connecting to obtain cookie with wrong password... "
oc_run svc --user test --password tost || oc_fail "POST request failed"

oc_expect_not 'Set-Cookie: webvpn=[^;]+' "Received cookie when we shouldn't"

echo "Connecting to obtain cookie with empty password... "
oc_run svc --user test --password '' || oc_fail "POST request failed"

oc_expect_not 'Set-Cookie: webvpn=[^;]+' "Received cookie when we shouldn't"

echo "Connecting to obtain cookie with wrong username... "
oc_run svc --user tost --password test || oc_fail "POST request failed"

oc_expect_not 'Set-Cookie: webvpn=[^;]+' "Received cookie when we shouldn't"

if ! test -f ${PIDFILE};then
	fail $PID "Could not find pid file ${PIDFILE}"
fi

cleanup

exit 0
